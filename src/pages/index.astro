---
// Original Memoresse Brand Guidebook Page 1 - Lockbox Hero
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Memoresse Brand Book - Page 1</title>
    <link href="https://fonts.googleapis.com/css2?family=Recoleta:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Recoleta', serif;
            background: #000;
        }
        
        .page {
            width: 100vw;
            height: 100vh;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            background-image: url('/src/assets/brand-assets/images/Page1-photo-memoresse-lockbox.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            overflow: hidden;
        }
        
        .logo-container {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 2;
            cursor: pointer;
            transition: transform 0.3s ease;
        }
        
        .logo-container:hover {
            transform: translate(-50%, -50%) scale(1.05);
        }
        
        .logo-img {
            height: 62px;
            width: auto;
            filter: brightness(0) saturate(100%) invert(98%) sepia(8%) saturate(0%) hue-rotate(180deg) brightness(105%) contrast(96%) drop-shadow(0 4px 8px rgba(0,0,0,0.3));
            /* CSS filter converts black logo to Off White (#fafafa) */
            transition: all 0.3s ease;
        }
        
        .logo-container:hover .logo-img {
            filter: brightness(0) saturate(100%) invert(81%) sepia(13%) saturate(15%) hue-rotate(75deg) brightness(94%) contrast(89%) drop-shadow(0 6px 12px rgba(0,0,0,0.4));
            /* Hover state converts to Sage Whisper (#b2c7b9) */
        }
        
        .brand-guidebook-text {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            font-family: 'Recoleta', serif;
            font-size: 18px;
            font-weight: 300;
            color: #fafafa;
            text-align: center;
            letter-spacing: 1.5px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
            text-transform: uppercase;
            z-index: 2;
        }
        
        /* Subtle overlay to ensure text readability */
        .overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 120px;
            background: linear-gradient(transparent, rgba(0,0,0,0.3));
            z-index: 1;
        }
        
        /* Responsive adjustments */
        @media (max-width: 1400px) {
            .logo-img {
                height: 50px;
            }
            
            .brand-guidebook-text {
                font-size: 16px;
                bottom: 30px;
            }
        }
        
        @media (max-width: 768px) {
            .logo-img {
                height: 30px;
            }
            
            .brand-guidebook-text {
                font-size: 14px;
                bottom: 20px;
                letter-spacing: 1px;
            }
        }
    </style>
</head>
<body>
    <div class="page">
        <div class="overlay"></div>
        <div class="logo-container">
            <img src="/src/assets/brand-assets/logos/Memoresse-Logo-Full.png" alt="Memoresse Logo" class="logo-img">
        </div>
        <div class="brand-guidebook-text">Memoresse Brand Guidebook</div>
    </div>
</body>
</html>