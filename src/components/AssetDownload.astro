---
// AssetDownload.astro - Interactive brand asset download component
export interface Props {
  assetName: string
  preview: string
  files: Record<string, string> // format -> Google Drive file ID
  description?: string
  category?: string
  usageGuideline?: string
  size?: 'small' | 'medium' | 'large'
}

const { 
  assetName, 
  preview, 
  files, 
  description = '', 
  category = 'Brand Asset',
  usageGuideline = '',
  size = 'medium'
} = Astro.props

// Generate unique IDs for this component instance
const componentId = `asset-${assetName.toLowerCase().replace(/\s+/g, '-')}`
const modalId = `modal-${componentId}`

// File format information
const formatInfo = {
  png: { name: 'PNG', description: 'High-quality with transparency • Web & print ready', icon: '🖼️' },
  svg: { name: 'SVG', description: 'Vector format • Infinitely scalable • Development ready', icon: '⚡' },
  jpg: { name: 'JPG', description: 'Standard photo format • Compressed • General use', icon: '📷' },
  eps: { name: 'EPS', description: 'Professional vector • Print production ready', icon: '🎨' },
  pdf: { name: 'PDF', description: 'Document format • Guidelines & specifications', icon: '📄' }
}
---

<div class={`asset-card group cursor-pointer ${size === 'small' ? 'p-4' : size === 'large' ? 'p-8' : 'p-6'}`} 
     data-asset={componentId}>
  
  <!-- Asset Preview -->
  <div class="flex items-center justify-center mb-4 relative overflow-hidden rounded-lg bg-memoresse-off-white border border-memoresse-memory-stone/10">
    <img 
      src={preview} 
      alt={`${assetName} preview`}
      class={`object-contain transition-transform duration-300 group-hover:scale-105 ${
        size === 'small' ? 'h-16' : size === 'large' ? 'h-32' : 'h-24'
      }`}
      loading="lazy"
    />
    
    <!-- Download overlay on hover -->
    <div class="absolute inset-0 bg-memoresse-sage-whisper/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
      <div class="text-center">
        <svg class="w-8 h-8 mx-auto mb-2 text-memoresse-stone-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span class="text-sm font-medium text-memoresse-stone-ink">Download</span>
      </div>
    </div>
  </div>

  <!-- Asset Information -->
  <div class="text-center">
    <h3 class="font-heading font-semibold text-memoresse-stone-ink mb-1">
      {assetName}
    </h3>
    
    {category && (
      <p class="text-xs text-memoresse-memory-stone uppercase tracking-wide font-medium mb-2">
        {category}
      </p>
    )}
    
    {description && (
      <p class="text-sm text-memoresse-memory-stone-dark leading-relaxed mb-3">
        {description}
      </p>
    )}

    <!-- Format badges -->
    <div class="flex justify-center gap-1 mb-3">
      {Object.keys(files).map(format => (
        <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-memoresse-lavender-mist/50 text-memoresse-stone-ink">
          {formatInfo[format]?.name || format.toUpperCase()}
        </span>
      ))}
    </div>

    <!-- Download button -->
    <button 
      class="btn-primary w-full text-sm no-print"
      onclick={`openAssetModal('${modalId}')`}
      aria-label={`Download ${assetName} in multiple formats`}
    >
      Download Asset
    </button>
  </div>
</div>

<!-- Download Modal -->
<div id={modalId} class="modal-overlay hidden no-print" role="dialog" aria-labelledby={`${modalId}-title`} aria-hidden="true">
  <div class="modal-content max-w-lg">
    <!-- Modal Header -->
    <div class="flex items-center justify-between mb-6">
      <h2 id={`${modalId}-title`} class="font-heading text-xl font-semibold text-memoresse-stone-ink">
        Download {assetName}
      </h2>
      <button 
        onclick={`closeAssetModal('${modalId}')`}
        class="text-memoresse-memory-stone hover:text-memoresse-stone-ink transition-colors p-1"
        aria-label="Close download modal"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Usage Guidelines -->
    {usageGuideline && (
      <div class="mb-6 p-4 bg-memoresse-sage-whisper/10 rounded-lg border border-memoresse-sage-whisper/20">
        <h3 class="font-medium text-memoresse-stone-ink mb-2 flex items-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Usage Guidelines
        </h3>
        <p class="text-sm text-memoresse-memory-stone-dark leading-relaxed">
          {usageGuideline}
        </p>
      </div>
    )}

    <!-- Format Options -->
    <div class="space-y-3 mb-6">
      <h3 class="font-medium text-memoresse-stone-ink">Choose Format:</h3>
      {Object.entries(files).map(([format, fileId]) => {
        const info = formatInfo[format] || { name: format.toUpperCase(), description: 'Standard format', icon: '📁' }
        return (
          <button 
            class="w-full text-left p-4 rounded-lg border border-memoresse-memory-stone/20 hover:border-memoresse-sage-whisper/40 hover:bg-memoresse-sage-whisper/5 transition-all duration-300 group"
            onclick={`downloadAsset('${fileId}', '${assetName}', '${format}')`}
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <span class="text-lg">{info.icon}</span>
                <div>
                  <div class="font-medium text-memoresse-stone-ink group-hover:text-memoresse-dusty-plum transition-colors">
                    {info.name}
                  </div>
                  <div class="text-sm text-memoresse-memory-stone-dark">
                    {info.description}
                  </div>
                </div>
              </div>
              <svg class="w-5 h-5 text-memoresse-memory-stone group-hover:text-memoresse-dusty-plum transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
          </button>
        )
      })}
    </div>

    <!-- Download Status -->
    <div id={`${modalId}-status`} class="hidden p-3 rounded-lg text-sm text-center"></div>

    <!-- Cancel Button -->
    <div class="flex justify-end">
      <button 
        onclick={`closeAssetModal('${modalId}')`}
        class="btn-tertiary"
      >
        Close
      </button>
    </div>
  </div>
</div>

<script>
  // Global functions for modal and download handling
  window.openAssetModal = function(modalId) {
    const modal = document.getElementById(modalId)
    if (modal) {
      modal.classList.remove('hidden')
      modal.setAttribute('aria-hidden', 'false')
      // Focus trap for accessibility
      const firstButton = modal.querySelector('button')
      if (firstButton) firstButton.focus()
    }
  }

  window.closeAssetModal = function(modalId) {
    const modal = document.getElementById(modalId)
    if (modal) {
      modal.classList.add('hidden')
      modal.setAttribute('aria-hidden', 'true')
    }
  }

  window.downloadAsset = function(fileId, assetName, format) {
    // Show download status
    const modalId = event.target.closest('.modal-overlay').id
    const statusEl = document.getElementById(`${modalId}-status`)
    
    if (statusEl) {
      statusEl.className = 'p-3 rounded-lg text-sm text-center bg-memoresse-sage-whisper/10 text-memoresse-dusty-plum border border-memoresse-sage-whisper/20'
      statusEl.textContent = `Preparing ${format.toUpperCase()} download...`
    }

    try {
      // Create download URL
      const downloadUrl = `https://drive.google.com/uc?export=download&id=${fileId}`
      
      // Create temporary link and trigger download
      const link = document.createElement('a')
      link.href = downloadUrl
      link.download = `${assetName}-${format}`
      link.target = '_blank'
      document.body.appendChild(link)
      link.click()
      document.body.removeChild(link)

      // Success feedback
      if (statusEl) {
        statusEl.className = 'p-3 rounded-lg text-sm text-center bg-green-50 text-green-700 border border-green-200'
        statusEl.textContent = `✓ ${format.toUpperCase()} download started successfully`
      }

      // Close modal after brief delay
      setTimeout(() => {
        closeAssetModal(modalId)
      }, 1500)

    } catch (error) {
      console.error('Download error:', error)
      
      // Error feedback
      if (statusEl) {
        statusEl.className = 'p-3 rounded-lg text-sm text-center bg-red-50 text-red-700 border border-red-200'
        statusEl.textContent = '✗ Download failed. Please try again.'
      }
    }
  }

  // Close modal on escape key
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      const openModal = document.querySelector('.modal-overlay:not(.hidden)')
      if (openModal) {
        closeAssetModal(openModal.id)
      }
    }
  })

  // Close modal on backdrop click
  document.addEventListener('click', function(event) {
    if (event.target.classList.contains('modal-overlay')) {
      closeAssetModal(event.target.id)
    }
  })
</script>

